{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cha-do-benicio",
  "main": "apps/api/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/web/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "benicio",
    "database_id": "SUBSTITUA_PELO_ID_DO_BANCO",
    "migrations_dir": "migrations"
  }]
}
